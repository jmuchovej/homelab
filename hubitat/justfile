set script-interpreter := ["bash", "-ueo", "pipefail"]

# In a module, justfile_directory() is the ROOT justfile's directory (the repo). That is
# where `-m hubitat` must resolve from; uv's --directory also makes it the cwd.
run := "uv run --directory " + justfile_directory() + " --package hubitat"

[private]
default:
    @just --justfile {{ module_file() }} --list

[doc('Regenerate <driver>.bundled.groovy for every driver (or only the given SOURCES)')]
bundle *ARGS:
    {{ run }} -m hubitat bundle {{ ARGS }}

[doc('Exit non-zero naming any stale bundle or disagreeing HPM manifest; writes nothing')]
check *ARGS:
    {{ run }} -m hubitat check {{ ARGS }}

[doc('Run the package tests (offline; no hub needed)')]
test *ARGS:
    {{ run }} python -m pytest hubitat/tests {{ ARGS }}

[doc('Create or update rbn drivers on the hub from their bundles; add --dry-run to only read')]
push *ARGS:
    secretspec run --reason 'just hubitat push' -- {{ run }} -m hubitat push {{ ARGS }}

[doc('Compile every library on the hub through a throwaway include-all driver, then delete it')]
probe:
    secretspec run --reason 'just hubitat probe' -- {{ run }} -m hubitat probe

[doc('Set DRIVER version(), timeStamp(), and manifest version/dateReleased, then re-bundle')]
bump DRIVER VERSION:
    {{ run }} -m hubitat bump {{ DRIVER }} {{ VERSION }}
