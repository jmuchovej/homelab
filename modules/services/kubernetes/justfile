set script-interpreter := [ "nu" ]

[private]
default:
    @just --justfile {{ module_file() }} --list

[doc('Refresh vendored schemas (bump cilium spec.version first; build check enforces sync)')]
[script]
update-schemas:
    let root = "{{ justfile_directory() }}"
    let schemas = ($root | path join "vendor" "schemas")
    mkdir $schemas

    # `open` yields a record for a single-document YAML and a list otherwise.
    let cilium_version = (
      [] | append (open ($root | path join "bootstrap" "kubernetes" "cilium.yaml"))
      | where kind == HelmChart | get -o 0.spec.version
    )
    if ($cilium_version | is-empty) {
      print -e "could not read spec.version from the cilium HelmChart"
      exit 1
    }

    let talos_image = (
      open ($root | path join "bootstrap" "talos" "machineconfig.yaml")
      | get -o machine.install.image
    )
    if ($talos_image | is-empty) {
      print -e "could not read machine.install.image from the talos machineconfig"
      exit 1
    }
    let talos_version = ($talos_image | split row ":v" | last)
    # Talos schemas are published per minor version, not per patch.
    let talos_minor = ($talos_version | split row "." | first 2 | str join ".")

    let cilium = "https://raw.githubusercontent.com/cilium/cilium"
    let crds = "https://raw.githubusercontent.com/datreeio/CRDs-catalog/main"
    let k8s = "https://raw.githubusercontent.com/yannh/kubernetes-json-schema/master/v1.33.1-standalone-strict"
    let sources = [
      [file, version, url];
      ["cilium-values.json", $cilium_version, $"($cilium)/v($cilium_version)/install/kubernetes/cilium/values.schema.json"]
      ["fluxinstance_v1.json", null, $"($crds)/fluxcd.controlplane.io/fluxinstance_v1.json"]
      ["helmchart_v1.json", null, $"($crds)/helm.cattle.io/helmchart_v1.json"]
      ["namespace-v1.json", null, $"($k8s)/namespace-v1.json"]
      ["secret-v1.json", null, $"($k8s)/secret-v1.json"]
      ["talos-config.json", $talos_version, $"https://docs.siderolabs.com/talos/v($talos_minor)/schemas/config.schema.json"]
    ]

    for s in $sources {
      print $"fetching ($s.file)"
      http get --raw $s.url | save -f ($schemas | path join $s.file)
    }

    $sources
    | reduce -f {} {|s, acc|
        let entry = if ($s.version | is-empty) { { url: $s.url } } else { { version: $s.version, url: $s.url } }
        $acc | insert $s.file $entry
      }
    | to json
    | $"($in)\n"
    | save -f ($schemas | path join "SOURCES.json")

    print $"vendored (ls $schemas | length) files into ($schemas) \(cilium chart ($cilium_version), talos ($talos_version)\)"

[doc('Sync per-cluster kubeconfigs into ~/.kube/config.d/ (all clusters, or one)')]
[script]
kubeconfig cluster="":
    # Which node serves a cluster is only expressed in host aspect lists, so
    # this map is maintained by hand.
    let servers = [
      [context, node];
      ["da", "da-vcx-1"]
      ["en", "en-t65-1"]
    ]

    let wanted = "{{ cluster }}"
    let targets = if ($wanted | is-empty) { $servers } else { $servers | where context == $wanted }
    if ($targets | is-empty) {
      print -e $"unknown cluster '($wanted)' — known: ($servers.context | str join ', ')"
      exit 1
    }

    let topology = (open $"{{ justfile_directory() }}/topology.yaml")
    let dir = ($nu.home-dir | path join ".kube" "config.d")
    mkdir $dir
    chmod 700 $dir

    # ~/.kube/config holds only current-context; k9s.nix puts it first in
    # KUBECONFIG so `use-context` writes there and never into a synced file.
    let state = ($nu.home-dir | path join ".kube" "config")
    if ($state | path exists) and (open --raw $state | from yaml | get -o clusters | is-not-empty) {
      let backup = $"($state).pre-multicluster"
      mv $state $backup
      print $"legacy single-cluster kubeconfig backed up -> ($backup)"
    }
    if not ($state | path exists) {
      { apiVersion: v1, kind: Config, current-context: $targets.0.context } | to yaml | save -f $state
      chmod 600 $state
    }

    for t in $targets {
      let addr = ($topology.clients | get -o $t.node | get -o ip)
      if ($addr | is-empty) {
        print -e $"($t.context): ($t.node) has no clients.($t.node).ip in topology.yaml — skipped"
        continue
      }

      let res = (^ssh -o ConnectTimeout=8 $"lab@($addr)" cat /etc/rancher/k3s/k3s.yaml | complete)
      if $res.exit_code != 0 {
        print -e $"($t.context): ($t.node) unreachable at ($addr) — skipped"
        print -e ($res.stderr | str trim)
        continue
      }

      let src = ($res.stdout | from yaml)
      let file = ($dir | path join $"($t.context).yaml")
      # k3s names cluster, user, and context `default` everywhere, so they are
      # renamed to the datacenter or the merged files collide.
      #
      # The served cert lacks the holonet address as a SAN and k3s will not
      # regrow SANs on restart, so `tls-server-name` pins verification to the
      # hostname that is in the cert. Drop it once the SANs are regenerated.
      {
        apiVersion: v1
        kind: Config
        clusters: [{ name: $t.context, cluster: {
          certificate-authority-data: $src.clusters.0.cluster.certificate-authority-data
          server: $"https://($addr):6443"
          tls-server-name: $t.node
        }}]
        users: [{ name: $t.context, user: {
          client-certificate-data: $src.users.0.user.client-certificate-data
          client-key-data: $src.users.0.user.client-key-data
        }}]
        contexts: [{ name: $t.context, context: { cluster: $t.context, user: $t.context } }]
      } | to yaml | save -f $file
      chmod 600 $file
      print $"($t.context) -> ($file)  [($addr), tls-server-name ($t.node)]"
    }
