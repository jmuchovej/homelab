# Populated by `just authentik discover-all`, which writes the auto-loaded
# `authentik.auto.tfvars.json`. Re-run after Authentik upgrades. Each recipe
# in authentik.just documents the key format of the map it produces.
variable "authentik-builtins" {
  type = object({
    blueprints        = map(string)
    flows             = map(string)
    stages            = map(string)
    property_mappings = map(string)
    policies          = map(string)
    prompt_fields     = map(string)
    bindings          = map(string)
    policy_bindings   = map(string)
    permissions       = map(string)
  })
  description = "Authentik default resource UUIDs, generated by `just discover-all` under src/terraform/authentik/."
  default = {
    blueprints        = {}
    flows             = {}
    stages            = {}
    property_mappings = {}
    policies          = {}
    prompt_fields     = {}
    bindings          = {}
    policy_bindings   = {}
    permissions       = {}
  }
}
