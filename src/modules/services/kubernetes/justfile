set script-interpreter := ['bash', '-euo', 'pipefail']

[private]
default:
    @just --justfile {{ module_file() }} --list

[doc('Refresh vendored schemas (bump cilium spec.version first; build check enforces sync)')]
[script]
update-schemas:
    manifests="{{ justfile_directory() }}/src/bootstrap/kubernetes"
    schemas="{{ justfile_directory() }}/vendor/schemas"
    mkdir -p "$schemas"

    cilium_version=$(yq 'select(.kind == "HelmChart") | .spec.version' "$manifests/cilium.yaml")
    [[ -n $cilium_version && $cilium_version != "null" ]] || {
        echo "could not read spec.version from $manifests/cilium.yaml" >&2
        exit 1
    }

    talos_image=$(yq '.machine.install.image' "{{ justfile_directory() }}/src/bootstrap/talos/machineconfig.yaml")
    talos_version=${talos_image##*:v}
    [[ -n $talos_version && $talos_version != "null" ]] || {
        echo "could not read machine.install.image from the talos machineconfig" >&2
        exit 1
    }
    # Talos schemas are published per minor version, not per patch.
    talos_minor=${talos_version%.*}

    fetch() {
        echo "fetching $2"
        curl -fsSL "$1" -o "$schemas/$2"
    }

    url_cilium="https://raw.githubusercontent.com/cilium/cilium/v${cilium_version}/install/kubernetes/cilium/values.schema.json"
    url_fluxinstance="https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/fluxcd.controlplane.io/fluxinstance_v1.json"
    url_helmchart="https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/helm.cattle.io/helmchart_v1.json"
    url_namespace="https://raw.githubusercontent.com/yannh/kubernetes-json-schema/master/v1.33.1-standalone-strict/namespace-v1.json"
    url_secret="https://raw.githubusercontent.com/yannh/kubernetes-json-schema/master/v1.33.1-standalone-strict/secret-v1.json"
    url_talos="https://docs.siderolabs.com/talos/v${talos_minor}/schemas/config.schema.json"

    fetch "$url_cilium" cilium-values.json
    fetch "$url_fluxinstance" fluxinstance_v1.json
    fetch "$url_helmchart" helmchart_v1.json
    fetch "$url_namespace" namespace-v1.json
    fetch "$url_secret" secret-v1.json
    fetch "$url_talos" talos-config.json

    cat > "$schemas/SOURCES.json" <<EOF
    {
      "cilium-values.json": {
        "version": "$cilium_version",
        "url": "$url_cilium"
      },
      "fluxinstance_v1.json": { "url": "$url_fluxinstance" },
      "helmchart_v1.json": { "url": "$url_helmchart" },
      "namespace-v1.json": { "url": "$url_namespace" },
      "secret-v1.json": { "url": "$url_secret" },
      "talos-config.json": {
        "version": "$talos_version",
        "url": "$url_talos"
      }
    }
    EOF

    echo "vendored $(ls "$schemas" | wc -l | tr -d ' ') files into $schemas" \
      "(cilium chart $cilium_version, talos $talos_version)"

[doc('Sync per-cluster kubeconfigs into ~/.kube/config.d/ (all clusters, or one)')]
[script('nu')]
kubeconfig cluster="":
    # Which node serves a cluster is only expressed in host aspect lists, so
    # this map is maintained by hand.
    let servers = [
      [context, node];
      ["da", "da-vcx-1"]
      ["en", "en-t65-1"]
    ]

    let wanted = "{{ cluster }}"
    let targets = if ($wanted | is-empty) { $servers } else { $servers | where context == $wanted }
    if ($targets | is-empty) {
      print -e $"unknown cluster '($wanted)' — known: ($servers.context | str join ', ')"
      exit 1
    }

    let topology = (open $"{{ justfile_directory() }}/src/topology.yaml")
    let dir = ($nu.home-dir | path join ".kube" "config.d")
    mkdir $dir
    chmod 700 $dir

    # ~/.kube/config holds only current-context; k9s.nix puts it first in
    # KUBECONFIG so `use-context` writes there and never into a synced file.
    let state = ($nu.home-dir | path join ".kube" "config")
    if ($state | path exists) and (open $state | get -o clusters | is-not-empty) {
      let backup = $"($state).pre-multicluster"
      mv $state $backup
      print $"legacy single-cluster kubeconfig backed up -> ($backup)"
    }
    if not ($state | path exists) {
      { apiVersion: v1, kind: Config, current-context: $targets.0.context } | to yaml | save -f $state
      chmod 600 $state
    }

    for t in $targets {
      let addr = ($topology.clients | get -o $t.node | get -o ip)
      if ($addr | is-empty) {
        print -e $"($t.context): ($t.node) has no clients.($t.node).ip in topology.yaml — skipped"
        continue
      }

      let res = (^ssh -o ConnectTimeout=8 $"lab@($addr)" cat /etc/rancher/k3s/k3s.yaml | complete)
      if $res.exit_code != 0 {
        print -e $"($t.context): ($t.node) unreachable at ($addr) — skipped"
        print -e ($res.stderr | str trim)
        continue
      }

      let src = ($res.stdout | from yaml)
      let file = ($dir | path join $"($t.context).yaml")
      # k3s names cluster, user, and context `default` everywhere, so they are
      # renamed to the datacenter or the merged files collide.
      #
      # The served cert lacks the holonet address as a SAN and k3s will not
      # regrow SANs on restart, so `tls-server-name` pins verification to the
      # hostname that is in the cert. Drop it once the SANs are regenerated.
      {
        apiVersion: v1
        kind: Config
        clusters: [{ name: $t.context, cluster: {
          certificate-authority-data: $src.clusters.0.cluster.certificate-authority-data
          server: $"https://($addr):6443"
          tls-server-name: $t.node
        }}]
        users: [{ name: $t.context, user: {
          client-certificate-data: $src.users.0.user.client-certificate-data
          client-key-data: $src.users.0.user.client-key-data
        }}]
        contexts: [{ name: $t.context, context: { cluster: $t.context, user: $t.context } }]
      } | to yaml | save -f $file
      chmod 600 $file
      print $"($t.context) -> ($file)  [($addr), tls-server-name ($t.node)]"
    }
